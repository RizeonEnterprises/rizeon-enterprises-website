# Copy to .env.local and fill in. Use the same project ID / dataset as studio/.env.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Optional. Only needed if the dataset is private.
# Create a "Viewer" token at https://www.sanity.io/manage -> API -> Tokens. Server-only, never NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
